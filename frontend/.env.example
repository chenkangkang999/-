# 前端公开配置，不得放入 LLM API Key、数据库密码或任何服务端密钥。
VITE_API_BASE_URL=/api/v1
# 留空时由 API 地址推导，默认同源。非空值填写服务根URL，例如 ws://127.0.0.1:8000
VITE_WS_BASE_URL=
VITE_API_TIMEOUT_MS=60000
VITE_RUN_POLL_MS=2000
# 仅供 Vite 开发代理使用，不注入浏览器包。
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
DEV_HOST=127.0.0.1
DEV_PORT=5173
# 工作台公开背景资源地址；仅用于视觉展示，可替换为自行部署的图片。
VITE_WORKSPACE_BACKGROUND_URL=/images/medical-atmosphere-v2.webp
