# 本机开发配置。密钥只放本机 .env，不提交。
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
APP_RUNTIME=local

# POSTGRES_HOST 留空使用 SQLite；容器运行时填写数据库密码。
POSTGRES_HOST=
POSTGRES_DB=medconsult
POSTGRES_USER=medconsult
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CONSULTATION_EXECUTOR=thread
CONSULTATION_WORKERS=2

# 同学提供的可替换接口
COORDINATOR_PROVIDER=agents.base.coordinator.Coordinator
HISTORY_PROVIDER=apps.consultations.services.ports.DatabaseHistory
HISTORY_MESSAGE_LIMIT=30
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=med_knowledge

# 真实 LLM；必须填写模型及密钥，不自动回退 Echo
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REQUEST_OPTIONS={}
LLM_PROMPTS_DIR=
SAFETY_RULES_PATH=
ENABLE_DEBATE=true
ENABLE_SAFETY_GATE=true
DEBATE_MAX_ROUNDS=2
ANSWER_CHUNK_SIZE=96

# 金额额度自行填写；单价通过后台 PricePlan 维护，单位为币种/千 token。
DAILY_COST_BUDGET_PER_USER=
DAILY_TOKEN_BUDGET_PER_USER=200000
BILLING_CURRENCY=CNY
BILLING_INPUT_TOKEN_OVERHEAD=128
BILLING_ESTIMATOR_ENCODING=cl100k_base

# 仅运行 RAG 容器时填写
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
