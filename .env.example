# 本机开发配置。密钥只放本机 .env，不提交。
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
APP_RUNTIME=local
# 本地数据库会话；Compose明确使用Redis缓存+数据库持久化会话。
SESSION_ENGINE=django.contrib.sessions.backends.db
SESSION_CACHE_ALIAS=default

# POSTGRES_HOST 留空使用 SQLite；容器运行时填写数据库密码。
POSTGRES_HOST=
POSTGRES_DB=medconsult
POSTGRES_USER=medconsult
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CONSULTATION_EXECUTOR=thread
CONSULTATION_WORKERS=2

# 同学提供的可替换接口
COORDINATOR_PROVIDER=agents.base.coordinator.Coordinator
HISTORY_PROVIDER=apps.consultations.services.langchain_history.LangChainHistory
HISTORY_MESSAGE_LIMIT=30
CLINICAL_INTAKE_ENABLED=true
CLINICAL_INTAKE_EXTRACTOR=llm
CLINICAL_INTAKE_POLICY_PATH=configs/clinical_intake.json
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=med_knowledge

# 真实 LLM；必须填写模型及密钥，不自动回退 Echo
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REQUEST_OPTIONS={}
LLM_PROMPTS_DIR=
SAFETY_RULES_PATH=
ENABLE_DEBATE=true
ENABLE_SAFETY_GATE=true
DEBATE_MAX_ROUNDS=2
ANSWER_CHUNK_SIZE=96
TOKEN_BUCKET_ENABLED=true
# memory仅用于单进程本机开发；容器环境用redis。
TOKEN_BUCKET_BACKEND=memory
TOKEN_BUCKET_CAPACITY=30
TOKEN_BUCKET_REFILL_PER_SECOND=0.5
TOKEN_BUCKET_MAX_KEYS=10000
APPROVED_RESPONSE_CACHE_ENABLED=true
APPROVED_RESPONSE_CACHE_TTL=300
APPROVED_RESPONSE_CACHE_MAX_CHARS=40000
COORDINATOR_WORKERS=4
TRIAGE_CONFIG_PATH=configs/triage.yaml
CLINICAL_FIELDS_PATH=configs/clinical_fields.json
CLINICAL_DATA_POLICY_PATH=configs/clinical_evidence.yaml
CLINICAL_DATA_ROOT=data/processed
CLINICAL_DATA_INDEX=.local/clinical/evidence.sqlite3

# 训练展示与飞轮：仅从配置目录读取产物；Web 不自动启动 GPU 训练。
LEARNING_MANIFEST_PATH=configs/learning_manifest.yaml
LEARNING_CONFIG_PATH=scripts/training.yaml
LEARNING_DATA_ROOT=data
LEARNING_ARTIFACT_ROOT=models/finetuned
LEARNING_HANDOFF_ROOT=.local/learning
LEARNING_MAX_IMPORT_BYTES=16777216
LEARNING_MAX_IMPORT_FILES=200
LEARNING_MAX_DATASET_BYTES=1073741824
LEARNING_MAX_CANDIDATES=5000
LEARNING_STALE_SECONDS=600
LEARNING_PREVIEW_RATE=30/min
LEARNING_PREVIEW_MAX_ROWS=5
LEARNING_PREVIEW_LINE_BYTES=65536
LEARNING_PREVIEW_FIELD_CHARS=500
LEARNING_VALIDATION_PERCENT=10
LEARNING_REQUIRE_HOLDOUT=true
LEARNING_PYTHON_EXECUTABLE=python

# 金额额度自行填写；单价通过后台 PricePlan 维护，单位为币种/千 token。
DAILY_COST_BUDGET_PER_USER=
DAILY_TOKEN_BUDGET_PER_USER=200000
BILLING_CURRENCY=CNY
BILLING_INPUT_TOKEN_OVERHEAD=128
BILLING_ESTIMATOR_ENCODING=cl100k_base

# 仅运行 RAG 容器时填写
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# RAG正式mode=milvus需本地BGE/LoRA与可达Milvus；不自动下载。
# bm25是真实CPU全语料稀疏降级模式，不代表已启用BGE或Milvus。
CACHE_IO_TIMEOUT=5
RAG_MODE=bm25
# 构建容器的可选向量依赖；默认不安装训练/向量模型依赖。
INSTALL_RAG=false
RAG_CORPORA_MANIFEST=configs/rag_corpora.json
RAG_ALLOWED_CORPUS_ROOTS=data
RAG_INDEX_DIR=.local/rag
RAG_MAX_MANIFEST_BYTES=1048576
RAG_MAX_CORPUS_BYTES=1073741824
RAG_MAX_RECORD_CHARS=200000
RAG_MAX_DOCUMENTS=0
RAG_INDEX_BATCH_SIZE=500
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_RETRIEVAL_LIMIT=40
RAG_SNIPPET_CHARS=500
RAG_QUERY_MAX_CHARS=4000
RAG_QUERY_MAX_TOKENS=64
RAG_TIMEOUT_SECONDS=15
RAG_DENSE_WEIGHT=0.5
RAG_RRF_CONSTANT=60
RAG_MILVUS_URI=http://127.0.0.1:19530
RAG_MILVUS_TOKEN=
RAG_COLLECTION_PREFIX=medical_full
RAG_ENABLE_MODEL_LOAD=false
RAG_BASE_MODEL_PATH=models/pretrained/BAAI/bge-m3
RAG_ADAPTER_PATH=
RAG_REQUIRE_ADAPTER=true
RAG_DEVICE=cpu
RAG_EMBED_BATCH_SIZE=16
RAG_RERANKER=none
RAG_RERANK_MODEL_PATH=models/reranker
RAG_CACHE_ALIAS=default
RAG_CACHE_TTL=300
