# ---------------------------------------------------------------------------
# 复制为 .env 后填写；.env 已被 .gitignore 排除，绝不提交
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 数据库（dev 默认 SQLite；prod 用下面的 PostgreSQL）
POSTGRES_DB=medconsult
POSTGRES_USER=medconsult
POSTGRES_PASSWORD=medconsult
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 向量库
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=med_knowledge

# LLM
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 业务开关
ENABLE_DEBATE=true
ENABLE_SAFETY_GATE=true
DAILY_TOKEN_BUDGET_PER_USER=200000