# ---- 行尾与文本规范化（项目约定）----
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# ---- 二进制文件（不做文本转换）----
*.png binary
*.jpg binary
*.pdf binary

